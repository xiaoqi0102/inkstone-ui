{
  "name": "inkstone-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "可复用 React 组件库：一套暖纸 + 钢蓝的设计令牌、通用组件与交互模式（日志还原、虚拟滚动、形变弹窗）",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "license": "MIT",
  "author": "xiaoqi0102",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoqi0102/inkstone-ui.git"
  },
  "homepage": "https://github.com/xiaoqi0102/inkstone-ui#readme",
  "bugs": {
    "url": "https://github.com/xiaoqi0102/inkstone-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "component-library",
    "design-system",
    "design-tokens",
    "tailwindcss",
    "oklch",
    "dark-mode",
    "shadcn"
  ]
}